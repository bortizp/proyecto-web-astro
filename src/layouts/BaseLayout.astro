---
// Tipografías instaladas como paquetes (se sirven desde el propio sitio, sin pedir nada a terceros): Manrope para textos y DM Mono para etiquetas.
import "@fontsource-variable/manrope";
import "@fontsource/dm-mono/400.css";
import "@fontsource/dm-mono/500.css";
// Estilos de todo el sitio.
import "../styles/global.css";

// Datos que recibe el layout desde cada página: título y descripción únicos.
interface Props {
  title: string;
  description: string;
}

// Lee el título y la descripción.
const { title, description } = Astro.props;
// Dirección base del sitio (GitHub Pages publica bajo /proyecto-web-astro).
// Ruta base del sitio, sin la barra final (en GitHub Pages es /proyecto-web-astro).
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// URL absoluta de la página y de la imagen para redes (Open Graph).
// Dirección completa de la página, para el enlace canónico y Open Graph.
const urlPagina = new URL(Astro.url.pathname, Astro.site).href;
// Dirección completa de la imagen que se muestra al compartir el sitio.
const urlImagen = new URL(`${base}/og.png`, Astro.site).href;
// Enlaces del menú superior: [ancla de la sección, texto visible]. Siguen el orden de la página.
const secciones = [
  ["sobre-la-carrera", "Carrera"],
  ["perfil-de-egreso", "Perfil"],
  ["plan-de-estudios", "Malla"],
  ["campo-laboral", "Campo laboral"],
  ["respaldo-institucional", "Respaldo"],
  ["admision", "Admisión"],
  ["preguntas-frecuentes", "FAQ"],
  ["referencias", "Fuentes"],
];
---

<!doctype html>
{/* Idioma declarado de la página: español de Chile. */}
<html lang="es-CL">
  <head>
    {/* Codificación de caracteres, para que se vean bien las tildes y la ñ. */}
    <meta charset="utf-8" />
    {/* Hace que la página se adapte al ancho del celular. */}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Indica con qué herramienta se construyó el sitio (Astro). */}
    <meta name="generator" content={Astro.generator} />
    {/* Descripción que muestran los buscadores. */}
    <meta name="description" content={description} />
    {/* Color de la barra del navegador en celulares. */}
    <meta name="theme-color" content="#10233f" />
    {/* Ícono de la pestaña (favicon). */}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    {/* Dirección oficial de la página, para evitar duplicados en buscadores. */}
    <link rel="canonical" href={urlPagina} />
    {/* Etiquetas Open Graph: controlan cómo se ve el enlace al compartirlo en redes y mensajería. */}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="Informática UTEM, por estudiantes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlPagina} />
    {/* Imagen de vista previa (1200×630) con su texto alternativo. */}
    <meta property="og:image" content={urlImagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Texto «Informática, sin venderte humo» sobre fondo azul oscuro" />
    {/* Tipo de tarjeta grande al compartir en X (Twitter). */}
    <meta name="twitter:card" content="summary_large_image" />
    {/* Título de la pestaña y de los resultados de búsqueda. */}
    <title>{title}</title>
  </head>
  <body>
    {/* Enlace oculto que permite saltar el menú con el teclado y llegar directo al contenido. */}
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    {/* Barra superior fija: marca, menú y botón de acción. */}
    <header class="topbar">
      {/* Marca del sitio; lleva al inicio. Su nombre accesible empieza con el texto visible. */}
      <a class="wordmark" href="#portada" aria-label="Informática UTEM por estudiantes, ir al inicio">
        <span class="mark" aria-hidden="true">{"{i}"}</span>
        <span aria-hidden="true">INFORMÁTICA<br />UTEM <small>/ por estudiantes</small></span>
      </a>
      {/* Menú de secciones, con nombre para lectores de pantalla. */}
      <nav aria-label="Secciones del sitio">
        <ul>
          {/* Crea un enlace por cada sección de la lista. */}
          {secciones.map(([id, nombre]) => (
            <li><a href={`#${id}`}>{nombre}</a></li>
          ))}
        </ul>
      </nav>
      {/* Botón que lleva directo al plan de estudios. */}
      <a class="nav-cta" href="#plan-de-estudios">Ver los 8 semestres</a>
    </header>
    {/* Contenido principal; aquí entra cada sección de la página (<slot />). */}
    <main id="contenido">
      <slot />
    </main>
    {/* Pie de página: aviso de que el sitio no es oficial y enlace para volver arriba. */}
    <footer class="site-footer">
      <div class="footer-mark" aria-hidden="true">{"{i}"}</div>
      <div>
        <strong>Hecho por estudiantes,<br />para futuros estudiantes.</strong>
        <p>
          Sitio informativo no oficial, hecho como proyecto universitario. Para
          decidir tu postulación, usa siempre las fuentes oficiales de la
          sección Referencias.
        </p>
      </div>
      <a href="#portada">Volver arriba ↑</a>
    </footer>
  </body>
</html>
