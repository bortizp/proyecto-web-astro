---
import "@fontsource-variable/manrope";
import "@fontsource/dm-mono/400.css";
import "@fontsource/dm-mono/500.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
// Dirección base del sitio (GitHub Pages publica bajo /proyecto-web-astro).
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// URL absoluta de la página y de la imagen para redes (Open Graph).
const urlPagina = new URL(Astro.url.pathname, Astro.site).href;
const urlImagen = new URL(`${base}/og.png`, Astro.site).href;
const secciones = [
  ["sobre-la-carrera", "Carrera"],
  ["perfil-de-egreso", "Perfil"],
  ["plan-de-estudios", "Malla"],
  ["campo-laboral", "Campo laboral"],
  ["respaldo-institucional", "Respaldo"],
  ["admision", "Admisión"],
  ["preguntas-frecuentes", "FAQ"],
  ["referencias", "Fuentes"],
];
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#10233f" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={urlPagina} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="Informática UTEM, por estudiantes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlPagina} />
    <meta property="og:image" content={urlImagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Texto «Informática, sin venderte humo» sobre fondo azul oscuro" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="topbar">
      <a class="wordmark" href="#portada" aria-label="Informática UTEM por estudiantes, ir al inicio">
        <span class="mark" aria-hidden="true">{"{i}"}</span>
        <span aria-hidden="true">INFORMÁTICA<br />UTEM <small>/ por estudiantes</small></span>
      </a>
      <nav aria-label="Secciones del sitio">
        <ul>
          {secciones.map(([id, nombre]) => (
            <li><a href={`#${id}`}>{nombre}</a></li>
          ))}
        </ul>
      </nav>
      <a class="nav-cta" href="#plan-de-estudios">Ver los 8 semestres</a>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-mark" aria-hidden="true">{"{i}"}</div>
      <div>
        <strong>Hecho por estudiantes,<br />para futuros estudiantes.</strong>
        <p>
          Sitio informativo no oficial, hecho como proyecto universitario. Para
          decidir tu postulación, usa siempre las fuentes oficiales de la
          sección Referencias.
        </p>
      </div>
      <a href="#portada">Volver arriba ↑</a>
    </footer>
  </body>
</html>
