---
// Referencias: lista ordenada de la colección `referencias`; cuenta fuentes primarias y
// muestra fecha del dato y fecha de consulta. Cada <li> tiene id para que [Fxx] enlace aquí.
import { getCollection } from "astro:content";
import Eyebrow from "./Eyebrow.astro";

const referencias = (await getCollection("referencias")).sort((a, b) =>
  a.id.localeCompare(b.id),
);
const primarias = referencias.filter((r) => r.data.tipo === "primaria").length;
---
<section id="referencias" class="section references">
  <div class="section-heading split-heading">
    <div>
      <Eyebrow>Referencias</Eyebrow>
      <h2>Todo dato se puede abrir, leer y discutir.</h2>
    </div>
    <p>
      Cada cifra del sitio lleva un código [F01] a [F{referencias.length}] que
      apunta a esta lista. Son {referencias.length} fuentes y {primarias} de
      ellas son primarias, es decir, vienen de quien produce el dato.
    </p>
  </div>
  <ol class="reference-list">
    {referencias.map(({ id, data }) => (
      <li id={id.toLowerCase()}>
        <b>[{id}]</b>
        <span>
          {data.referencia}
          <span class="meta">
            Fuente {data.tipo} · fecha del dato: {data.fechaDato} · consultada el {data.fechaConsulta}
          </span>
        </span>
        <a href={data.url} rel="noopener noreferrer" aria-label={`Abrir fuente ${id}`}>Abrir ↗</a>
      </li>
    ))}
  </ol>
</section>
