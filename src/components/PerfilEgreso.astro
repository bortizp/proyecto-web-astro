---
// Perfil de egreso: capacidades con su mapeo a ramos de la malla. Texto fijo; las fuentes
// se citan con <Cita> y lo que concluye el equipo se marca como interpretación.
// Componentes reutilizables: la cita [Fxx], la etiqueta (dato/interpretación) y el título de sección.
import Cita from "./Cita.astro";
import Etiqueta from "./Etiqueta.astro";
import Eyebrow from "./Eyebrow.astro";

// Cada capacidad resume un punto del perfil publicado por la UTEM (F01).
// "En la malla" es nuestra relación con ramos de la resolución (F02): interpretación.
// Lista de las cinco capacidades del perfil. Cada una tiene número, título, texto y los ramos de la malla que se le relacionan.
const capacidades = [
  {
    // Número que se muestra en la tarjeta.
    n: "01",
    // Título corto de la capacidad.
    titulo: "Diseñar y desarrollar",
    // Texto resumido del perfil de egreso oficial (F01).
    texto: "Soluciones de software y sistemas de información, e integrarlas.",
    // Ramos relacionados: lectura del equipo sobre la resolución (F02).
    malla: "Algoritmos y Programación, Ingeniería de Software, Computación Móvil y Web",
  },
  {
    n: "02",
    titulo: "Gestionar",
    texto: "Redes y recursos computacionales, y administrar tecnologías de la información.",
    malla: "Redes y Comunicación de Datos, Sistemas Operativos, Computación en la Nube",
  },
  {
    n: "03",
    titulo: "Asegurar",
    texto: "Seguridad, confiabilidad, calidad y eficiencia de cada solución.",
    malla: "Ciberseguridad, Análisis de Algoritmos, Desarrollo Ágil",
  },
  {
    n: "04",
    titulo: "Trabajar en cualquier sector",
    texto: "Organizaciones públicas, privadas y del tercer sector.",
    malla: "Práctica Profesional, Evaluación de Proyectos Informáticos",
  },
  {
    n: "05",
    titulo: "Seguir creciendo",
    texto: "Aprendizaje continuo, comunicación, trabajo en equipo, emprendimiento e innovación.",
    malla: "Taller de Innovación y Emprendimiento, Gestión de Proyectos Informáticos",
  },
];
---
{/* Sección con ancla "perfil-de-egreso", a la que apunta el menú superior. */}
<section id="perfil-de-egreso" class="section profile">
  {/* Encabezado de la sección: título y explicación breve. */}
  <div class="section-heading compact">
    <Eyebrow>Perfil de egreso</Eyebrow>
    <h2>¿Qué deberías poder hacer al salir?</h2>
    <p>
      No una lista de adjetivos: cinco capacidades concretas, resumidas del
      perfil de egreso que publica la universidad <Cita id="F01" />.
    </p>
  </div>
  {/* Cuadrícula de tarjetas, una por capacidad. */}
  <div class="capability-grid">
    {/* Recorre la lista `capacidades` y crea una tarjeta por cada una. */}
    {capacidades.map((c) => (
      <article class="capability">
        <span>{c.n}</span>
        <h3>{c.titulo}</h3>
        <p>{c.texto} <Cita id="F01" /></p>
        <p class="in-curriculum">En la malla: {c.malla} <Cita id="F02" /></p>
      </article>
    ))}
  </div>
  {/* Aviso que separa lo oficial de lo que interpreta el equipo (etiqueta "Interpretación"). */}
  <div class="interpretation">
    <Etiqueta tipo="interpretacion" naranjo />
    <p>
      La relación entre cada capacidad y los ramos de la malla es nuestra
      lectura, no un dato oficial. El título no te encierra en un cargo: te
      entrega una base amplia y la especialización suele llegar con electivos,
      práctica y proyectos.
    </p>
  </div>
</section>
