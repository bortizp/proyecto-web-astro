---
// Admisión: cifras clave, tabla de ponderaciones (F01) y checklist. La suma de 110 % se
// explica como interpretación del equipo, porque la UTEM no lo aclara.
import Cita from "./Cita.astro";
import Etiqueta from "./Etiqueta.astro";
import Eyebrow from "./Eyebrow.astro";

// Ponderaciones tal como las publica la UTEM en la página de la carrera (F01): [factor, detalle, porcentaje].
// Nombres tal como los publica la UTEM en la página de la carrera (F01).
// Lista de factores de selección.
const ponderaciones = [
  // Notas de Enseñanza Media (NEM).
  ["NEM", "Notas de Enseñanza Media (NEM)", "10 %"],
  // Ranking de notas.
  ["Ranking", "Ranking de notas", "25 %"],
  // Prueba de Competencia Lectora (CL).
  ["Competencia Lectora (CL)", "PAES", "20 %"],
  // Prueba de Competencia Matemática 1 (M1).
  ["Competencia Matemática 1 (M1)", "PAES", "30 %"],
  // Prueba de Competencia Matemática 2 (M2).
  ["Competencia Matemática 2 (M2)", "PAES", "5 %"],
  // Prueba electiva de Ciencias.
  ["Electiva de Ciencias", "PAES", "10 %"],
  // Prueba electiva de Historia y Ciencias Sociales.
  ["Electiva de Historia y Ciencias Sociales", "PAES", "10 %"],
];

---
{/* Sección con ancla "admision", a la que apunta el menú superior. */}
<section id="admision" class="section admissions">
  <div class="section-heading split-heading">
    <div>
      <Eyebrow>Admisión</Eyebrow>
      <h2>Antes de postular,<br />saca tus cuentas.</h2>
    </div>
    <p>
      La UTEM admite a sus estudiantes de pregrado por la Prueba de Acceso a la
      Educación Superior (PAES) <Cita id="F06" />. Los datos de abajo son los
      que publica la universidad para esta carrera <Cita id="F01" />. La página
      no indica el año del proceso; consultamos las cifras el 8 de noviembre de
      2026, así que confírmalas antes de postular.
    </p>
  </div>
  {/* Cuatro cifras clave: vacantes, puntaje mínimo, matrícula y arancel, cada una con su cita. */}
  <dl class="key-figures">
    <div><dt>Vacantes</dt><dd>150 <Cita id="F01" /></dd></div>
    <div><dt>Promedio mínimo entre Competencia Lectora (CL) y Matemática 1 (M1)</dt><dd>458 pts. <Cita id="F01" /></dd></div>
    <div><dt>Matrícula</dt><dd>$90.000 <Cita id="F01" /></dd></div>
    <div><dt>Arancel anual</dt><dd>$4.763.300 <Cita id="F01" /></dd></div>
  </dl>
  {/* Dos columnas: tablas a la izquierda y checklist a la derecha. */}
  <div class="admission-layout">
    <div>
      <div class="table-wrap">
        <table>
          {/* La tabla de ponderaciones lleva título (caption) para lectores de pantalla. */}
          <caption>Ponderaciones según la UTEM <Cita id="F01" /></caption>
          <thead>
            <tr><th scope="col">Factor de selección</th><th scope="col">Ponderación</th></tr>
          </thead>
          <tbody>
            {/* Una fila por factor de selección. */}
            {ponderaciones.map(([nombre, detalle, valor]) => (
              <tr>
                <th scope="row">{nombre}<small>{detalle}</small></th>
                <td>{valor}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {/* Nota que explica por qué la suma da 110 %; es interpretación del equipo. */}
      <p class="table-note">
        <Etiqueta tipo="interpretacion" enLinea naranjo />
        Si sumas todas las filas da 110 %. Las dos últimas son pruebas
        electivas; nuestra lectura es que se considera una de las dos, y así el
        total da 100 %. La página no lo explica, así que confírmalo con la
        universidad.
      </p>
    </div>
    {/* Lista de verificación antes de postular, con enlaces a las fuentes. */}
    <aside class="checklist" aria-labelledby="checklist-titulo">
      <span class="tag tag-orange">Antes de enviar</span>
      <h3 id="checklist-titulo">Checklist honesto</h3>
      <ul>
        <li>Revisé vacantes y requisitos del año.</li>
        <li>Calculé mi puntaje con las ponderaciones.</li>
        <li>Comparé la malla, no solo el nombre de la carrera.</li>
        <li>Revisé las fechas del proceso en el Departamento de Evaluación, Medición y Registro Educacional (DEMRE) <Cita id="F07" />.</li>
        <li>Leí las instrucciones de postulación <Cita id="F08" />.</li>
      </ul>
      {/* Enlace a la página oficial de admisión de la UTEM; abre sin dar acceso a esta página (noopener). */}
      <a class="button dark" href="https://www.utem.cl/admision/admision-acceso-via-paes/" rel="noopener noreferrer">
        Ir a Admisión UTEM <span aria-hidden="true">↗</span>
      </a>
    </aside>
  </div>
</section>
